# ==============================================================================
# RegImpact-SL - Environment Configuration Template
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit .env files containing real credentials to version control.
# ==============================================================================

# --- Database & Persistent Storage (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql://regimpact_user:change_me@localhost:5432/regimpact_sl
POSTGRES_USER=regimpact_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=regimpact_sl
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Path to persistent local store for authoritative raw PDF source documents
PDF_STORAGE_DIR=backend/data/raw_sources

# --- LLM Provider Configuration (Milestone 2+) ---
# Supported providers: gemini | openai | anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=30

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Embedding & Retrieval Configuration (Milestone 3+) ---
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
HYBRID_RRF_K=60
RETRIEVAL_TOP_K=10

# --- Frontend & API Service Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
